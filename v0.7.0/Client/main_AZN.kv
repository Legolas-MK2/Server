

<Element>:
    BoxLayout:
        orientation:'vertical'
        GridLayout:
            rows: 2
            size_hint: 1, None
            size: 1, 150
            spacing: 10
            padding: 10
            MDTextField:
                hint_text: "Arbeitszeit Start"
                mode: "rectangle"
            MDTextField:
                hint_text: "Pause 1 Start"
                mode: "rectangle"
            MDTextField:
                hint_text: "Pause 2 Start"
                mode: "rectangle"
            MDTextField:
                hint_text: "Pause 3 Start"
                mode: "rectangle"
            MDTextField:
                hint_text: "Arbeitszeit Ende"
                mode: "rectangle"
            MDTextField:
                hint_text: "Pause 1 Ende"
                mode: "rectangle"
            MDTextField:
                hint_text: "Pause 2 Ende"
                mode: "rectangle"
            MDTextField:
                hint_text: "Pause 3 Ende"
                mode: "rectangle"
        BoxLayout:
            GridLayout:
                rows: 2
                Label:
                    text: "GLAZ"
                Label:
                    text: "Krank"
                Label:
                    text: "Urlaub"
                Label:
                    text: "Schule"
                MDCheckbox:
                    group: 'group'
                    size_hint: None, None
                    size: dp(48), dp(48)
                MDCheckbox:
                    group: 'group'
                    size_hint: None, None
                    size: dp(48), dp(48)
                MDCheckbox:
                    group: 'group'
                    size_hint: None, None
                    size: dp(48), dp(48)
                MDCheckbox:
                    group: 'group'
                    size_hint: None, None
                    size: dp(48), dp(48)
            MDTextField:
                hint_text: "Bemerkungen"






<MainWindow>:
    name: "main"

    GridLayout:
        cols:1

        GridLayout:
            cols: 2

            Label:
                text: "Password: "

            TextInput:
                id: passw
                multiline: False

        Button:
            text: "Submit"
            on_release:
                app.root.current = "second" if passw.text == "tim" else "main"
                root.manager.transition.direction = "left"


<SecondWindow>:
    name: "second"

    Button:
        text: "Go Back"
        on_release:
            app.root.current = "main"
            root.manager.transition.direction = "right"