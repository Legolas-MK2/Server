

<test>:
    MDCard:
        orientation: "vertical"
        padding: "8dp"
        size_hint: 0.4, None
        size: "280dp", root.ids.body.texture_size[1]+40
        pos_hint: {"center_x": .5, "center_y": .5}
        padding: 5
        spacing: 5

        MDLabel:
            id: body
            text: "akjwdhaliwfifguawkofuafopiuafkuazhfklahdfaowui"
            theme_text_color: "Secondary"
            size_hint_y: None
            height: self.texture_size[1]

        MDSeparator:
            height: "1dp"

        MDLabel:
            id: bottom
            text: str(round(root.ids.body.size[0]))
            theme_text_color: "Secondary"
            size_hint_y: None
            height: self.texture_size[1]


<MainWindow>:
    name: "main"

    MDScrollView:
        MDList:
            id: main_contact



<Chat>:
    name: "chat"

    BoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            title: "MDToolbar"
            left_action_items:[["microsoft-xbox-controller-menu", lambda x: root.set_screen("main")]]
            right_action_items:[["dots-vertical", lambda x: root.me2()]]
        MDScrollView:
            MDList:
                MDCard:
                    orientation: "vertical"
                    padding: "8dp"
                    size_hint: 0.4, None
                    size: "20dp", root.ids.body.texture_size[1]+75
                    #pos_hint: {"center_x": .5, "center_y": .5}
                    padding: 5
                    spacing: 5

                    MDLabel:
                        id: top
                        text: "Name"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDSeparator:
                        height: "1dp"

                    MDLabel:
                        id: body
                        text: "akjwdhaliwfifguawkofuafopiuafkuazhfklahdfaowui"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDSeparator:
                        height: "1dp"

                    MDLabel:
                        id: bottom
                        text: str(round(root.ids.body.size[0]))
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]
        BoxLayout:
            size_hint: 1,None
            size: 1, 50
            Button: